# Mercury hub secrets and settings. install.sh copies this to $MERCURY_HOME/.env
# (chmod 600). Never commit the real file.

# -- Relay ----------------------------------------------------------------------
# Admin token shared by the relay, the agent plugin and the `mercury` CLI.
# Generate with: mercury admin-token --write
MERCURY_ADMIN_TOKEN=
# The relay listens here; put a TLS reverse proxy in front (see deploy/Caddyfile).
MERCURY_RELAY_HOST=127.0.0.1
MERCURY_RELAY_PORT=8765
# Public HTTPS URL devices use to reach the relay, e.g. https://mercury.example.com
MERCURY_PUBLIC_URL=
# shared: all your devices continue one conversation with Mercury. per-device: one thread each.
MERCURY_CONVERSATION=shared

# -- API server (chat-completions compatible, for scripts, tests and the desktop app) --
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_SERVER_KEY=

# -- WhatsApp (left unconfigured until Mercury's own SIM/number is ready) --------
# Then run `mercury whatsapp` to scan the QR code with Mercury's phone.
WHATSAPP_ENABLED=false
WHATSAPP_MODE=bot
# Numbers allowed to talk to Mercury: country code, no +, comma separated.
WHATSAPP_ALLOWED_USERS=

# -- Model provider key (only for a hosted provider) -------------------------------
# `mercury model` writes the right variable here when you sign in, e.g.:
# <PROVIDER>_API_KEY=

# -- Research tools (optional) ---------------------------------------------------
# Web search for skill research. Without a key the agent can still read pages it is
# pointed to. Options include FIRECRAWL_API_KEY, EXA_API_KEY, or the free DuckDuckGo
# backend (`mercury pm install ddgs`).
# FIRECRAWL_API_KEY=
